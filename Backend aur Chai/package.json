    "node"
  ],
  "license": "ISC",
  "author": "Aman Dwivedi",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "start": "node src/index.js",
    "worker:video": "node -r dotenv/config src/workers/video.worker.js",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/controllers/video.controller.js && node --check src/controllers/user.controller.js && node --check src/workers/video.worker.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.5",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^2.0.2",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  }
}
